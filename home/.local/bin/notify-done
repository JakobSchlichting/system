#!/bin/zsh
# Runs a command and sends a macOS notification when it completes.
# Usage: notify-done <command> [args...]

if [[ $# -eq 0 ]]; then
  echo "Usage: notify-done <command> [args...]" >&2
  exit 1
fi

"$@"
exit_code=$?

if [[ $exit_code -eq 0 ]]; then
  title="Command Completed"
  message="✓ $*"
else
  title="Command Failed (exit $exit_code)"
  message="✗ $*"
fi

osascript -e "display notification \"$message\" with title \"$title\""

exit $exit_code
